## CyberGuard XAI - Local Environment Configuration
## Copy this file to `local.properties` and fill in your actual credentials.
## NEVER commit your actual `local.properties` to version control.

# Android SDK Path (configured by Android Studio)
# sdk.dir=C:\\Users\\<username>\\AppData\\Local\\Android\\Sdk

# Supabase Credentials (from your Supabase project settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# FastAPI Backend URL
BACKEND_BASE_URL=http://10.0.2.2:8000

# Google Sign-In Web Client ID (from Google Cloud Console / Supabase Auth provider settings)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
